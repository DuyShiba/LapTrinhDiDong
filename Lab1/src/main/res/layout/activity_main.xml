<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="20dp"
    android:background="#FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Ảnh sinh viên -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/profile_image"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:src="@drawable/avt"
        app:civ_border_width="3dp"
        app:civ_border_color="#03A9F4"
        android:layout_marginBottom="16dp" />

    <!-- Thông tin sinh viên -->
    <TextView
        android:id="@+id/student_info"
        android:text="Phạm Lê Anh Duy\nID: 23162012\nSinh viên trường Đại học Sư Phạm Kĩ Thuật Thành Phố Hồ Chí Minh"
        android:textAlignment="center"
        android:textSize="16sp"
        android:textColor="#000000"
        android:layout_marginBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- ========== TASK 4: Xử lý mảng số ========== -->
    <EditText
        android:id="@+id/array_input_edit_text"
        android:hint="Nhập dãy số, ví dụ: 1,2,3,4,5"
        android:layout_marginBottom="10dp"
        android:inputType="text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/process_array_button"
        android:text="Xử lý dãy số"
        android:layout_marginBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/even_numbers_text_view"
        android:text="Số chẵn:"
        android:textColor="#000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/odd_numbers_text_view"
        android:text="Số lẻ:"
        android:textColor="#000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp" />

    <!-- ========== TASK 5: Đảo chuỗi & in hoa ========== -->
    <EditText
        android:id="@+id/edit_text"
        android:hint="Nhập chuỗi cần đảo ngược"
        android:layout_marginBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/button"
        android:text="Đảo ngược và IN HOA"
        android:layout_marginBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/result_text_view"
        android:text="Kết quả đảo chuỗi sẽ hiển thị tại đây"
        android:textColor="#000000"
        android:textSize="16sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>
